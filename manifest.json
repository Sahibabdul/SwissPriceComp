{
  "manifest_version": 3,
  "name": "SwissPriceComp",
  "version": "0.0.3",
  "description": "Shows the lowest Toppreise.ch price on Digitec, Galaxus, Interdiscount, Brack and Conrad product pages.",
  "icons": {
    "128": "assets/images/icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "@swisspricecomp",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.toppreise.ch/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.digitec.ch/*",
        "https://www.galaxus.ch/*",
        "https://www.interdiscount.ch/*",
        "https://www.brack.ch/*",
        "https://www.conrad.ch/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}